<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8" />
    <title>
        <%= action==='add' ?'Tambah Menu':'Edit Menu' %> — Hungry
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet" />
    <style>
        :root {
            --green: #06C167;
            --green-dark: #049a52;
            --gray-50: #f6f6f6;
            --gray-100: #eeeeee;
            --gray-400: #8a8a8a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f6f6f6;
            color: #000;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 240px;
            background: #000;
            color: #fff;
            padding: 28px 20px;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            top: 0;
            left: 0;
        }

        .sidebar-logo {
            font-size: 20px;
            font-weight: 900;
            letter-spacing: -0.5px;
            margin-bottom: 40px;
        }

        .sidebar-logo span {
            color: var(--green);
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #888;
            text-decoration: none;
            padding: 11px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            transition: all .15s;
        }

        .nav-item:hover {
            background: #111;
            color: #fff;
        }

        .nav-item.active {
            background: var(--green);
            color: #fff;
            font-weight: 700;
        }

        .sidebar-bottom {
            margin-top: auto;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #888;
            background: none;
            border: none;
            padding: 11px 14px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            border-radius: 8px;
            width: 100%;
            transition: all .15s;
            text-decoration: none;
        }

        .btn-logout:hover {
            background: #1a1a1a;
            color: #fff;
        }

        /* MAIN */
        .main {
            margin-left: 240px;
            flex: 1;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 48px 32px;
        }

        /* FORM CARD */
        .form-card {
            background: #fff;
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 560px;
            border: 1px solid var(--gray-100);
        }

        .form-tag {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            color: var(--green);
            margin-bottom: 8px;
        }

        .form-card h1 {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .form-card p.sub {
            color: var(--gray-400);
            font-size: 14px;
            margin-bottom: 32px;
        }

        .error-box {
            background: #fff0f0;
            border: 1px solid #fca5a5;
            color: #dc2626;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            font-size: 13px;
            font-weight: 500;
        }

        label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #333;
            margin-bottom: 7px;
        }

        input,
        textarea,
        select {
            width: 100%;
            padding: 13px 16px;
            border: 1.5px solid var(--gray-100);
            border-radius: 8px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: border .15s;
            background: #fff;
            color: #000;
            margin-bottom: 20px;
            resize: vertical;
        }

        input:focus,
        textarea:focus,
        select:focus {
            border-color: #000;
        }

        .hint {
            font-size: 12px;
            color: var(--gray-400);
            margin-top: -16px;
            margin-bottom: 20px;
        }

        .preview-box {
            border: 1.5px dashed var(--gray-100);
            border-radius: 8px;
            height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-bottom: 20px;
            background: var(--gray-50);
        }

        .preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 6px;
        }

        .preview-box span {
            color: var(--gray-400);
            font-size: 13px;
        }

        .form-footer {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-top: 4px;
        }

        .btn-submit {
            background: #000;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 14px 24px;
            font-weight: 800;
            font-size: 15px;
            cursor: pointer;
            flex: 1;
            transition: background .15s;
        }

        .btn-submit:hover {
            background: #222;
        }

        .btn-cancel {
            color: #666;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            padding: 14px 16px;
        }

        .btn-cancel:hover {
            color: #000;
        }
    </style>
</head>

<body>
    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-logo">HUNGRY</span></div>
            <nav class="sidebar-nav">
                <a href="/gobite" class="nav-item"><span>📦</span> Dashboard</a>
                <a href="/menu" class="nav-item active"><span>🍔</span> Kelola Menu</a>
                <a href="/" class="nav-item"><span>🏠</span> Beranda</a>
            </nav>
            <div class="sidebar-bottom">
                <a href="/logout" class="btn-logout"><span>🚪</span> Keluar</a>
            </div>
        </aside>

        <!-- FORM -->
        <main class="main">
            <div class="form-card">
                <div class="form-tag">
                    <%= action==='add' ? '+ New Item' : '✏️ Edit Item' %>
                </div>
                <h1>
                    <%= action==='add' ? 'Tambah Menu Baru' : 'Edit Menu' %>
                </h1>
                <p class="sub">
                    <%= action==='add' ? 'Isi detail menu yang akan ditambahkan ke katalog'
                        : 'Perbarui informasi menu ini' %>
                </p>

                <!-- Error validasi dari Sequelize (dikumpulkan via promise chain di controller) -->
                <% if (error) { %>
                    <div class="error-box">⚠️ <%= error %>
                    </div>
                    <% } %>

                        <!-- Image Preview -->
                        <div class="preview-box" id="previewBox">
                            <% if (menu && menu.imageUrl) { %>
                                <img id="previewImg" src="<%= menu.imageUrl %>"
                                    onerror="this.parentElement.innerHTML='<span>Preview gambar</span>'" />
                                <% } else { %>
                                    <span>Preview gambar</span>
                                    <% } %>
                        </div>

                        <form action="/menu/<%= action==='add' ? 'add' : 'edit/'+menu.id %>" method="POST">

                            <label for="menu">Nama Menu *</label>
                            <input type="text" id="menu" name="menu" placeholder="Contoh: Nasi Goreng Spesial"
                                value="<%= menu ? menu.menu : '' %>" required />

                            <label for="price">Harga (Rp) *</label>
                            <input type="number" id="price" name="price" placeholder="15000" min="1000"
                                value="<%= menu ? menu.price : '' %>" required />
                            <p class="hint">Minimal Rp1.000 — validasi Sequelize akan memeriksa input ini</p>

                            <label for="description">Deskripsi</label>
                            <textarea id="description" name="description" rows="3"
                                placeholder="Deskripsi singkat menu..."
                                maxlength="500"><%= menu ? menu.description || '' : '' %></textarea>

                            <label for="imageUrl">URL Gambar</label>
                            <input type="url" id="imageUrl" name="imageUrl" placeholder="https://example.com/foto.jpg"
                                value="<%= menu ? menu.imageUrl || '' : '' %>" oninput="updatePreview(this.value)" />
                            <p class="hint">Opsional — URL validasi oleh Sequelize isUrl</p>

                            <div class="form-footer">
                                <button type="submit" class="btn-submit">
                                    <%= action==='add' ? '+ Tambah Menu' : '💾 Simpan Perubahan' %>
                                </button>
                                <a href="/menu" class="btn-cancel">Batal</a>
                            </div>
                        </form>
            </div>
        </main>

    </div>
    <script>
        function updatePreview(url) {
            const box = document.getElementById('previewBox');
            if (url) {
                box.innerHTML = '<img src="' + url + '" style="width:100%;height:100%;object-fit:cover;border-radius:6px" onerror="this.parentElement.innerHTML=\'<span style=color:#aaa;font-size:13px>URL tidak valid</span>\'" />';
            } else {
                box.innerHTML = '<span style="color:#aaa;font-size:13px">Preview gambar</span>';
            }
        }
    </script>
</body>

</html>