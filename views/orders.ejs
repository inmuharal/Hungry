<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orders – HUNGRY UP</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Nunito:wght@400;600;700;800&display=swap"
    rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    * {
      font-family: 'Nunito', sans-serif;
    }

    body {
      background: #FFF8F0;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-weight: 900;
      color: #3E1F0D;
    }

    .section-title span {
      color: #C0392B;
    }

    .btn-add-order {
      background: linear-gradient(135deg, #C0392B, #E74C3C);
      color: #fff;
      border: none;
      border-radius: 50px;
      font-weight: 800;
      padding: 8px 22px;
      transition: opacity .2s;
    }

    .btn-add-order:hover {
      opacity: .86;
      color: #fff;
    }

    .filter-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 4px 16px rgba(192, 57, 43, .1);
      overflow: hidden;
    }

    .filter-header {
      background: linear-gradient(135deg, #3E1F0D, #6B2D0F);
      color: #FFF8F0;
      font-weight: 800;
      padding: 14px 20px;
      font-size: 1rem;
    }

    .form-select,
    .form-control {
      border: 2px solid #E8C9A0;
      border-radius: 12px;
      padding: 8px 14px;
      background: #fff;
    }

    .form-select:focus,
    .form-control:focus {
      border-color: #C0392B;
      box-shadow: 0 0 0 3px rgba(192, 57, 43, .12);
    }

    .btn-filter-apply {
      background: linear-gradient(135deg, #C0392B, #E74C3C);
      color: #fff;
      border: none;
      border-radius: 50px;
      font-weight: 800;
      padding: 8px 20px;
      transition: opacity .2s;
    }

    .btn-filter-apply:hover {
      opacity: .86;
      color: #fff;
    }

    .btn-filter-reset {
      border: 2px solid #C0392B;
      color: #C0392B;
      background: transparent;
      border-radius: 50px;
      font-weight: 700;
      padding: 8px 20px;
      transition: all .2s;
    }

    .btn-filter-reset:hover {
      background: #C0392B;
      color: #fff;
    }

    .table-wrapper {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 4px 16px rgba(192, 57, 43, .1);
      overflow: hidden;
    }

    .table thead {
      background: linear-gradient(135deg, #3E1F0D, #6B2D0F);
      color: #FFF8F0;
    }

    .table thead th {
      border: none;
      font-weight: 800;
      padding: 14px 12px;
    }

    .table tbody tr:hover {
      background: #FFF8F0;
    }

    .badge-driver {
      background: linear-gradient(135deg, #D4A017, #E67E22);
      color: #fff;
      border-radius: 50px;
      padding: 3px 12px;
      font-size: .78rem;
      font-weight: 800;
    }

    .badge-food {
      background: #FFF0E0;
      color: #8B3000;
      border: 1px solid #E8C9A0;
      border-radius: 50px;
      padding: 3px 10px;
      font-size: .78rem;
      font-weight: 700;
    }

    .badge-user {
      background: #FFF8F0;
      color: #6B2D0F;
      border: 1px solid #E8C9A0;
      border-radius: 50px;
      padding: 3px 10px;
      font-size: .78rem;
      font-weight: 700;
    }

    .price-text {
      color: #C0392B;
      font-weight: 800;
    }

    .btn-invoice {
      border: 2px solid #D4A017;
      color: #D4A017;
      border-radius: 50px;
      font-size: .8rem;
      font-weight: 700;
      padding: 4px 12px;
      transition: all .2s;
    }

    .btn-invoice:hover {
      background: #D4A017;
      color: #fff;
    }

    .btn-delete {
      background: linear-gradient(135deg, #C0392B, #922B21);
      color: #fff;
      border: none;
      border-radius: 50px;
      font-size: .8rem;
      font-weight: 700;
      padding: 4px 12px;
      transition: opacity .2s;
    }

    .btn-delete:hover {
      opacity: .82;
      color: #fff;
    }

    .alert-success {
      border-radius: 14px;
      border: none;
      background: #F5FFF0;
      color: #1a6a1a;
      font-weight: 600;
    }

    .alert-danger {
      border-radius: 14px;
      border: none;
      background: #FFF0F0;
      color: #8B0000;
      font-weight: 600;
    }
  </style>
</head>

<body>
  <% const pageMessage=typeof message !=="undefined" ? message : null; %>
    <% const pageError=typeof error !=="undefined" ? error : null; %>
      <% const toRupiah=typeof formatRupiah !=="undefined" ? formatRupiah : (value)=> new Intl.NumberFormat("id-ID", {
        style: "currency", currency: "IDR", maximumFractionDigits: 0 }).format(Number(value) || 0); %>

        <%- include("navbar", { search: "" }) %>
          <div class="container py-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
              <h3 class="section-title mb-0">📦 <span>Orders</span></h3>
              <% if (userRole==="pembeli" ) { %>
                <a href="/orders/add" class="btn btn-add-order">+ Add Order</a>
                <% } %>
            </div>

            <% if (pageMessage) { %>
              <div class="alert alert-success alert-dismissible fade show">Pesanan berhasil dihapus
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
              <% } %>
                <% if (pageError) { %>
                  <div class="alert alert-danger alert-dismissible fade show">
                    <%= pageError %>
                      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                  </div>
                  <% } %>

                    <!-- Filter -->
                    <div class="filter-card mb-4">
                      <div class="filter-header">🔍 Filter Orders</div>
                      <div class="p-3">
                        <form method="get" action="/orders" class="row g-3 align-items-end">
                          <div class="col-md-5">
                            <label class="form-label fw-bold" style="color:#3E1F0D;">Driver</label>
                            <select name="driverId" class="form-select">
                              <option value="">-- All Drivers --</option>
                              <% drivers.forEach(driver=> { %>
                                <option value="<%= driver.id %>" <%=filterDriverId==driver.id ? "selected" : "" %>><%=
                                    driver.name %> (<%= driver.phoneNumber %>)</option>
                                <% }) %>
                            </select>
                          </div>
                          <div class="col-md-5">
                            <label class="form-label fw-bold" style="color:#3E1F0D;">Food (Menu)</label>
                            <select name="menuId" class="form-select">
                              <option value="">-- All Food Items --</option>
                              <% menus.forEach(menu=> { %>
                                <option value="<%= menu.id %>" <%=filterMenuId==menu.id ? "selected" : "" %>><%=
                                    menu.menu %>
                                </option>
                                <% }) %>
                            </select>
                          </div>
                          <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-filter-apply flex-fill">Apply</button>
                            <a href="/orders" class="btn btn-filter-reset flex-fill">Reset</a>
                          </div>
                        </form>
                      </div>
                    </div>

                    <!-- Active badges -->
                    <% if (filterDriverId || filterMenuId) { %>
                      <div class="mb-3 d-flex gap-2 flex-wrap">
                        <% if (filterDriverId) { const d=drivers.find(x=> String(x.id) === String(filterDriverId)); %>
                          <span class="badge-driver" style="padding:6px 16px;font-size:.85rem;">
                            🚗 Driver: <%= d ? d.name : filterDriverId %>
                              <a href="/orders?menuId=<%= filterMenuId %>"
                                class="text-white ms-2 text-decoration-none">✕</a>
                          </span>
                          <% } %>
                            <% if (filterMenuId) { const m=menus.find(x=> String(x.id) === String(filterMenuId)); %>
                              <span class="badge-food" style="padding:6px 16px;font-size:.85rem;">
                                🍔 Food: <%= m ? m.menu : filterMenuId %>
                                  <a href="/orders?driverId=<%= filterDriverId %>" style="color:#8B3000;"
                                    class="ms-2 text-decoration-none">✕</a>
                              </span>
                              <% } %>
                                <span class="badge-user" style="padding:6px 16px;font-size:.85rem;">
                                  <%= data.length %> result<%= data.length !==1 ? "s" : "" %>
                                </span>
                      </div>
                      <% } %>

                        <!-- Table -->
                        <div class="table-wrapper">
                          <div class="table-responsive">
                            <table class="table table-hover mb-0">
                              <thead>
                                <tr>
                                  <th>#</th>
                                  <th>Order Name</th>
                                  <th>Address</th>
                                  <th>Customer</th>
                                  <th>🚗 Driver</th>
                                  <th>Phone</th>
                                  <th>🍔 Food</th>
                                  <th>Total Price</th>
                                  <th>Action</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% if (data.length===0) { %>
                                  <tr>
                                    <td colspan="9" class="text-center py-5" style="color:#C0392B;font-weight:700;">🍽️
                                      No orders found.</td>
                                  </tr>
                                  <% } else { %>
                                    <% data.forEach((order, index)=> { %>
                                      <tr>
                                        <td>
                                          <%= index + 1 %>
                                        </td>
                                        <td><strong>
                                            <%= order.name %>
                                          </strong></td>
                                        <td><span class="text-muted small">
                                            <%= order.address %>
                                          </span></td>
                                        <td>
                                          <% if (order.User) { %><span class="badge-user">
                                              <%= order.User.name %>
                                            </span>
                                            <% } else { %>–<% } %>
                                        </td>
                                        <td class="<%= filterDriverId ? 'table-warning' : '' %>">
                                          <% if (order.Driver) { %>
                                            <strong>
                                              <%= order.Driver.name %>
                                            </strong><br>
                                            <span class="badge-driver">
                                              <%= order.Driver.license %>
                                            </span>
                                            <% } else { %>–<% } %>
                                        </td>
                                        <td>
                                          <% if (order.Driver) { %><span class="small">
                                              <%= order.Driver.phoneNumber %>
                                            </span>
                                            <% } else { %>–<% } %>
                                        </td>
                                        <td class="<%= filterMenuId ? 'table-warning' : '' %>">
                                          <% if (order.Menus && order.Menus.length) { %>
                                            <% order.Menus.forEach(menu=> { %><span
                                                class="badge-food d-inline-block mb-1">🍔 <%= menu.menu %></span>
                                              <% }) %>
                                                <% } else { %>–<% } %>
                                        </td>
                                        <td>
                                          <% const fallback=(order.Menus || []).reduce((s, m)=> s + Number(m.price ||
                                            0), 0); %>
                                            <span class="price-text">
                                              <%= toRupiah(order.price || fallback) %>
                                            </span>
                                        </td>
                                        <td>
                                          <a href="/orders/<%= order.id %>/invoice" class="btn btn-invoice mb-1">🧾
                                            Invoice</a>
                                          <% if (userRole==="penjual" ) { %>
                                            <a href="/orders/<%= order.id %>/delete" class="btn btn-delete mb-1"
                                              onclick="return confirm('Yakin ingin menghapus?')">Delete</a>
                                            <% } %>
                                        </td>
                                      </tr>
                                      <% }) %>
                                        <% } %>
                              </tbody>
                            </table>
                          </div>
                        </div>
          </div>
          <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>