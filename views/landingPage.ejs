<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>HUNGRY UP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Nunito:wght@400;600;700;800&display=swap"
    rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --crimson: #C0392B;
      --ember: #E74C3C;
      --gold: #D4A017;
      --amber: #E67E22;
      --choco: #3E1F0D;
      --cream: #FFF8F0;
      --warm: #FFF0E0;
    }

    * {
      font-family: 'Nunito', sans-serif;
    }

    body {
      background: var(--cream);
    }

    .carousel-caption {
      background: rgba(30, 10, 0, .55);
      border-radius: 12px;
      padding: 12px 22px;
      backdrop-filter: blur(4px);
    }

    .carousel-caption h3 {
      font-family: 'Playfair Display', serif;
      font-weight: 900;
      color: #FFD700;
    }

    .hero-section {
      background: linear-gradient(135deg, var(--choco) 0%, #6B2D0F 50%, var(--crimson) 100%);
      color: var(--cream);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
    }

    .hero-section::before {
      font-size: 2.4rem;
      position: absolute;
      top: 10px;
      left: 0;
      right: 0;
      text-align: center;
      opacity: .08;
      letter-spacing: 22px;
      pointer-events: none;
    }

    .hero-section h1 {
      font-family: 'Playfair Display', serif;
      font-weight: 900;
      font-size: 2.8rem;
      text-shadow: 0 3px 12px rgba(0, 0, 0, .4);
    }

    .hero-section p {
      opacity: .9;
      font-size: 1.1rem;
    }

    .btn-hero {
      background: linear-gradient(135deg, var(--gold), var(--amber));
      color: #fff;
      font-weight: 800;
      border-radius: 50px;
      padding: 12px 38px;
      font-size: 1.05rem;
      border: none;
      box-shadow: 0 6px 20px rgba(212, 160, 23, .4);
      transition: transform .2s, box-shadow .2s;
    }

    .btn-hero:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 28px rgba(212, 160, 23, .5);
      color: #fff;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-weight: 900;
      font-size: 2rem;
      color: var(--choco);
    }

    .section-title span {
      color: var(--crimson);
    }

    .card {
      border: none;
      border-radius: 16px;
      overflow: hidden;
      background: #fff;
      transition: transform .28s, box-shadow .28s;
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 18px 44px rgba(192, 57, 43, .18) !important;
    }

    .card-title {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      color: var(--choco);
    }

    .card-text {
      color: var(--crimson);
      font-weight: 800;
    }

    .promo-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background: linear-gradient(135deg, var(--crimson), var(--ember));
      color: #fff;
      padding: 4px 14px;
      font-size: 11px;
      font-weight: 800;
      border-radius: 50px;
      box-shadow: 0 2px 8px rgba(192, 57, 43, .3);
    }

    .btn-order {
      background: linear-gradient(135deg, var(--crimson), var(--ember));
      color: #fff;
      border: none;
      border-radius: 50px;
      font-weight: 800;
      transition: opacity .2s, transform .2s;
    }

    .btn-order:hover {
      opacity: .86;
      color: #fff;
      transform: scale(1.03);
    }

    .divider-food {
      text-align: center;
      font-size: 1.5rem;
      letter-spacing: 10px;
      padding: 4px 0;
      opacity: .4;
    }

    footer {
      background: var(--choco);
      color: var(--cream);
      font-weight: 700;
      letter-spacing: .3px;
    }
  </style>
</head>

<body>

  <%- include("navbarLandingPage") %>

    <!-- CAROUSEL -->
    <div id="promoCarousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">
        <div class="carousel-item active">
          <img src="https://images.unsplash.com/photo-1600891964599-f61ba0e24092" class="d-block w-100"
            style="height:440px;object-fit:cover;filter:brightness(.78) saturate(1.3);">
          <div class="carousel-caption d-none d-md-block">
            <h3>🔥 Diskon 50% Hari Ini!</h3>
            <p>Promo terbatas hanya untuk pelanggan baru</p>
          </div>
        </div>
        <div class="carousel-item">
          <img src="https://images.unsplash.com/photo-1550547660-d9450f859349" class="d-block w-100"
            style="height:440px;object-fit:cover;filter:brightness(.78) saturate(1.3);">
          <div class="carousel-caption d-none d-md-block">
            <h3>🚚 Gratis Ongkir</h3>
            <p>Untuk 100 order pertama hari ini</p>
          </div>
        </div>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#promoCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#promoCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>
    </div>

    <!-- HERO -->
    <section class="hero-section text-center">
      <div class="container">
        <h1>Pesan Makanan Lebih Cepat</h1>
        <p class="lead mt-2">Sistem driver otomatis siap mengantar makanan favoritmu</p>
        <a href="/login" class="btn btn-hero mt-4">Mulai Sekarang 🍽️</a>
      </div>
    </section>


    <!-- MENU -->
    <section class="container py-5">
      <h2 class="section-title text-center mb-4">Menu <span>Terbaru</span> 🍽️</h2>
      <div class="row">
        <% if (data.length===0) { %>
          <div class="text-center">
            <p style="color:var(--crimson);font-weight:700;">Belum ada menu tersedia</p>
          </div>
          <% } %>
            <% data.forEach(menu=> { %>
              <div class="col-md-4 mb-4">
                <div class="card shadow h-100 position-relative">
                  <span class="promo-badge">🔥 Hot Deal</span>
                  <img src="<%= menu.imageUrl %>" class="card-img-top" style="height:210px;object-fit:cover;">
                  <div class="card-body d-flex flex-column">
                    <h5 class="card-title">
                      <%= menu.menu %>
                    </h5>
                    <p class="card-text">Rp <%= menu.price %>
                    </p>
                    <a href="/login" class="btn btn-order mt-auto w-100">Order Sekarang 🛒</a>
                  </div>
                </div>
              </div>
              <% }) %>
      </div>
    </section>

    <footer class="text-center py-4">
      <p class="mb-0">© 2026 HUNGRY UP — Food Delivery App</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>