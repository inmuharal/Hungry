<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register – HUNGRY UP</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Nunito:wght@400;600;700;800&display=swap"
    rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    * {
      font-family: 'Nunito', sans-serif;
    }

    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #6B2D0F 0%, #3E1F0D 40%, #C0392B 100%);
      display: flex;
      flex-direction: column;
    }

    .reg-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px 16px;
    }

    .reg-card {
      background: #FFF8F0;
      border-radius: 24px;
      box-shadow: 0 20px 60px rgba(62, 31, 13, .45);
      padding: 48px 44px;
      width: 100%;
      max-width: 460px;
      border-top: 5px solid #E67E22;
    }

    .reg-logo {
      font-family: 'Playfair Display', serif;
      font-weight: 900;
      font-size: 1.9rem;
      color: #3E1F0D;
      margin-bottom: 4px;
    }

    .reg-logo span {
      color: #E67E22;
    }

    .reg-sub {
      color: #9B5A35;
      font-weight: 600;
      font-size: .92rem;
      margin-bottom: 24px;
    }

    .form-label {
      font-weight: 700;
      color: #3E1F0D;
    }

    .form-control,
    .form-select {
      border: 2px solid #E8C9A0;
      border-radius: 12px;
      padding: 10px 14px;
      background: #fff;
      transition: border-color .2s, box-shadow .2s;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: #E67E22;
      box-shadow: 0 0 0 3px rgba(230, 126, 34, .15);
    }

    .btn-register {
      background: linear-gradient(135deg, #D4A017, #E67E22);
      color: #fff;
      font-weight: 800;
      border: none;
      border-radius: 50px;
      padding: 12px;
      font-size: 1rem;
      transition: opacity .2s, transform .2s;
    }

    .btn-register:hover {
      opacity: .87;
      transform: scale(1.02);
      color: #fff;
    }

    .reg-footer {
      color: #9B5A35;
      margin-top: 16px;
      font-size: .93rem;
    }

    .reg-footer a {
      color: #C0392B;
      font-weight: 700;
      text-decoration: none;
    }

    .reg-footer a:hover {
      text-decoration: underline;
    }

    .alert-danger {
      border-radius: 12px;
      border: none;
      background: #FFF0F0;
      color: #8B0000;
      font-weight: 600;
    }

    footer {
      background: rgba(0, 0, 0, .25);
      color: #FFF8F0;
      text-align: center;
      padding: 12px;
      font-size: .85rem;
      font-weight: 600;
    }
  </style>
</head>

<body>
  <div class="reg-wrapper">
    <div class="reg-card">
      <div class="reg-logo">🥩 Buat <span>Akun</span></div>
      <div class="reg-sub">Bergabung dan pesan makananmu hari ini!</div>

      <% if (errors.length) { %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% errors.forEach(error=> { %><li>
                <%= error %>
              </li>
              <% }) %>
          </ul>
        </div>
        <% } %>

          <form action="/register" method="post">
            <div class="mb-3">
              <label class="form-label">Name</label>
              <input type="text" name="name" class="form-control" placeholder="Nama lengkap">
            </div>
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" name="email" class="form-control" placeholder="email@kamu.com">
            </div>
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input type="password" name="password" class="form-control" placeholder="Min. 8 karakter">
            </div>
            <div class="mb-3">
              <label class="form-label">Role</label>
              <select name="role" class="form-select">
                <option value="pembeli">🛒 Pembeli</option>
                <option value="penjual">🏪 Penjual</option>
              </select>
            </div>
            <button class="btn btn-register w-100 mt-2">Daftar Sekarang 🍴</button>
          </form>
          <p class="reg-footer text-center">Sudah punya akun? <a href="/login">Login</a></p>
    </div>
  </div>
  <footer>© 2026 HUNGRY UP 🍖 — Food Delivery App</footer>
</body>

</html>