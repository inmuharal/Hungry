<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>HUNGRY UP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      --mango: #FFBE00;
      --tangerine: #FF7043;
      --watermelon: #FF4D6D;
      --lime: #A8E063;
      --sky: #E0F7FA;
      --white: #FFFFFF;
    }

    * {
      font-family: 'Nunito', sans-serif;
    }

    body {
      background: var(--sky);
    }

    /* ── NAVBAR ── */
    .navbar {
      background: var(--white) !important;
      box-shadow: 0 2px 12px rgba(255, 190, 0, .18);
    }

    .navbar-brand {
      font-weight: 900;
      font-size: 1.5rem;
      background: linear-gradient(90deg, var(--tangerine), var(--watermelon));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* ── CAROUSEL OVERLAY ── */
    .carousel-caption {
      background: rgba(0, 0, 0, .35);
      border-radius: 16px;
      padding: 12px 20px;
    }

    .carousel-caption h3 {
      font-weight: 800;
      text-shadow: 0 2px 6px rgba(0, 0, 0, .3);
    }

    /* ── HERO ── */
    .hero-section {
      background: linear-gradient(135deg, var(--mango) 0%, var(--tangerine) 50%, var(--watermelon) 100%);
      color: var(--white);
      padding: 72px 0;
      position: relative;
      overflow: hidden;
    }

    .hero-section::before {
      content: "🍉🍋🥭🍊🍓🍍";
      font-size: 2.4rem;
      position: absolute;
      top: 10px;
      left: 0;
      right: 0;
      text-align: center;
      opacity: .18;
      letter-spacing: 24px;
      pointer-events: none;
    }

    .hero-section h1 {
      font-weight: 900;
      font-size: 2.6rem;
      text-shadow: 0 3px 10px rgba(0, 0, 0, .15);
    }

    .hero-section p {
      font-size: 1.15rem;
      margin-top: 8px;
    }

    .hero-section .btn-hero {
      background: var(--white);
      color: var(--tangerine);
      font-weight: 800;
      border-radius: 50px;
      padding: 12px 36px;
      font-size: 1.05rem;
      box-shadow: 0 4px 18px rgba(0, 0, 0, .15);
      transition: transform .2s, box-shadow .2s;
    }

    .hero-section .btn-hero:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .22);
    }

    /* ── SECTION HEADING ── */
    .section-title {
      font-weight: 900;
      font-size: 2rem;
      background: linear-gradient(90deg, var(--tangerine), var(--watermelon));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* ── CARDS ── */
    .card {
      border: none;
      border-radius: 20px;
      overflow: hidden;
      transition: transform .28s ease, box-shadow .28s ease;
      background: var(--white);
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 40px rgba(255, 112, 67, .18) !important;
    }

    .card-title {
      font-weight: 800;
      color: #333;
    }

    .card-text {
      color: var(--tangerine);
      font-weight: 700;
      font-size: 1rem;
    }

    /* ── PROMO BADGE ── */
    .promo-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background: linear-gradient(135deg, var(--mango), var(--tangerine));
      color: var(--white);
      padding: 4px 14px;
      font-size: 11px;
      font-weight: 800;
      border-radius: 50px;
      letter-spacing: .5px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, .15);
    }

    /* ── ORDER BUTTON ── */
    .btn-order {
      background: linear-gradient(135deg, var(--mango), var(--tangerine));
      color: var(--white);
      border: none;
      border-radius: 50px;
      font-weight: 800;
      transition: opacity .2s, transform .2s;
    }

    .btn-order:hover {
      opacity: .88;
      color: var(--white);
      transform: scale(1.03);
    }

    /* ── FRUIT DIVIDER ── */
    .fruit-divider {
      text-align: center;
      font-size: 1.6rem;
      letter-spacing: 12px;
      padding: 6px 0;
      opacity: .55;
    }

    /* ── FOOTER ── */
    footer {
      background: linear-gradient(135deg, var(--tangerine), var(--watermelon));
      color: var(--white);
      font-weight: 700;
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <%- include("navbarLandingPage") %>

    <!-- SLIDE PROMOSI -->
    <div id="promoCarousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">

        <div class="carousel-item active">
          <img src="https://images.unsplash.com/photo-1600891964599-f61ba0e24092" class="d-block w-100"
            style="height:420px; object-fit:cover; filter:brightness(.88) saturate(1.2);">
          <div class="carousel-caption d-none d-md-block">
            <h3>🔥 Diskon 50% Hari Ini!</h3>
            <p>Promo terbatas hanya untuk pelanggan baru</p>
          </div>
        </div>

        <div class="carousel-item">
          <img src="https://images.unsplash.com/photo-1550547660-d9450f859349" class="d-block w-100"
            style="height:420px; object-fit:cover; filter:brightness(.88) saturate(1.2);">
          <div class="carousel-caption d-none d-md-block">
            <h3>🚚 Gratis Ongkir</h3>
            <p>Untuk 100 order pertama hari ini</p>
          </div>
        </div>

      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#promoCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#promoCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>
    </div>

    <!-- HERO SECTION -->
    <section class="hero-section text-center">
      <div class="container">
        <h1 class="fw-bold">🍉 Pesan Makanan Lebih Cepat</h1>
        <p class="lead">Sistem driver otomatis siap mengantar makanan favoritmu</p>
        <a href="/login" class="btn btn-hero btn-lg mt-4">Mulai Sekarang 🚀</a>
      </div>
    </section>

    <!-- FRUIT DIVIDER -->
    <div class="fruit-divider my-2">🍓 🍋 🥭 🍊 🍍 🍇</div>

    <!-- MENU TERBARU -->
    <section class="container py-5">
      <h2 class="section-title text-center mb-4">Menu Terbaru 🍽️</h2>

      <div class="row">
        <% if (data.length===0) { %>
          <div class="text-center">
            <p style="color:var(--tangerine); font-weight:700;">Belum ada menu tersedia</p>
          </div>
          <% } %>

            <% data.forEach(menu=> { %>
              <div class="col-md-4 mb-4">
                <div class="card shadow h-100 position-relative">

                  <span class="promo-badge">🌟 Promo</span>

                  <img src="<%= menu.imageUrl %>" class="card-img-top" style="height:210px; object-fit:cover;">
                  <div class="card-body d-flex flex-column">
                    <h5 class="card-title">
                      <%= menu.menu %>
                    </h5>
                    <p class="card-text">Rp <%= menu.price %>
                    </p>

                    <a href="/login" class="btn btn-order mt-auto w-100">
                      Order Sekarang 🛒
                    </a>
                  </div>
                </div>
              </div>
              <% }) %>

      </div>
    </section>

    <!-- FOOTER -->
    <footer class="text-center py-3">
      <p class="mb-0">© 2026 HUNGRY UP 🍉 — Food Delivery App</p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>