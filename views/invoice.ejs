<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice <%= invoiceNumber %>
    </title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Nunito:wght@300;400;600;700;800&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: #FFF8F0;
            color: #1a0a00;
            font-size: 14px;
            padding: 40px 20px;
        }

        .invoice-wrapper {
            max-width: 780px;
            margin: 0 auto;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 8px 36px rgba(192, 57, 43, .2);
            overflow: hidden;
        }

        /* HEADER */
        .invoice-header {
            background: linear-gradient(135deg, #3E1F0D 0%, #6B2D0F 55%, #C0392B 100%);
            color: #FFF8F0;
            padding: 36px 48px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .invoice-header .brand {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 900;
            letter-spacing: -.5px;
            color: #FFF8F0;
        }

        .invoice-header .brand span {
            color: #D4A017;
        }

        .invoice-header .meta {
            text-align: right;
        }

        .invoice-header .meta .inv-number {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 900;
            color: #D4A017;
            margin-bottom: 4px;
        }

        .invoice-header .meta .inv-date {
            font-size: 12px;
            color: rgba(255, 248, 240, .7);
        }

        /* BODY */
        .invoice-body {
            padding: 40px 48px;
        }

        .address-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            margin-bottom: 36px;
        }

        .address-block .label {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #D4A017;
            margin-bottom: 8px;
        }

        .address-block .name {
            font-size: 16px;
            font-weight: 800;
            color: #3E1F0D;
            margin-bottom: 4px;
        }

        .address-block p {
            color: #6B4226;
            line-height: 1.6;
            font-size: 13px;
        }

        .divider {
            border: none;
            border-top: 2px solid #F0D8C0;
            margin: 28px 0;
        }

        /* Items table */
        table.items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 32px;
        }

        table.items-table thead th {
            background: linear-gradient(135deg, #FFF0E0, #F0D8C0);
            padding: 12px 16px;
            text-align: left;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6B2D0F;
            border-bottom: 2px solid #E8C9A0;
        }

        table.items-table thead th:last-child {
            text-align: right;
        }

        table.items-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #FFF0E0;
            font-size: 13px;
            color: #333;
        }

        table.items-table tbody td:last-child {
            text-align: right;
            font-weight: 700;
            color: #C0392B;
        }

        table.items-table tbody tr:last-child td {
            border-bottom: none;
        }

        /* Totals */
        .totals-section {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 32px;
        }

        .totals-table {
            width: 280px;
        }

        .totals-table .row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 13px;
            color: #6B4226;
            border-bottom: 1px solid #FFF0E0;
        }

        .totals-table .row.total {
            font-size: 18px;
            font-weight: 900;
            color: #3E1F0D;
            border-bottom: none;
            padding-top: 14px;
        }

        .totals-table .row.total .amount {
            color: #C0392B;
        }

        /* Driver note */
        .driver-note {
            background: #FFF0E0;
            border-left: 4px solid #D4A017;
            border-radius: 8px;
            padding: 14px 18px;
            margin-bottom: 32px;
            font-size: 13px;
            color: #3E1F0D;
        }

        .driver-note strong {
            color: #C0392B;
        }

        /* Footer */
        .invoice-footer {
            background: linear-gradient(135deg, #3E1F0D, #6B2D0F);
            padding: 24px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .invoice-footer p {
            font-size: 13px;
            color: #D4A017;
            font-weight: 700;
        }

        .invoice-footer .print-btn {
            background: linear-gradient(135deg, #D4A017, #E67E22);
            color: #fff;
            border: none;
            padding: 10px 28px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            transition: opacity .2s, transform .2s;
        }

        .invoice-footer .print-btn:hover {
            opacity: .87;
            transform: scale(1.03);
        }

        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            text-decoration: none;
            color: #C0392B;
            font-size: 13px;
            font-weight: 700;
        }

        .back-link:hover {
            opacity: .75;
        }

        @media print {
            body {
                background: #fff;
                padding: 0;
            }

            .invoice-wrapper {
                box-shadow: none;
                border-radius: 0;
            }

            .invoice-footer .print-btn,
            a.back-link {
                display: none;
            }
        }
    </style>
</head>

<body>
    <a href="/orders" class="back-link">← Back to Orders</a>

    <div class="invoice-wrapper">

        <!-- Header -->
        <div class="invoice-header">
            <div>
                <div class="brand">🍖 Food<span>App</span></div>
                <p style="color:rgba(255,248,240,.7);font-size:12px;margin-top:6px;">
                    <%= seller.address %>
                </p>
                <p style="color:rgba(255,248,240,.7);font-size:12px;">
                    <%= seller.phone %> · <%= seller.email %>
                </p>
            </div>
            <div class="meta">
                <div class="inv-number">
                    <%= invoiceNumber %>
                </div>
                <div class="inv-date">Date: <%= invoiceDate %>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="invoice-body">

            <div class="address-grid">
                <div class="address-block">
                    <div class="label">From</div>
                    <div class="name">
                        <%= seller.name %>
                    </div>
                    <p>
                        <%= seller.address %><br>
                            <%= seller.email %>
                    </p>
                </div>
                <div class="address-block">
                    <div class="label">Bill To</div>
                    <div class="name">
                        <%= order.User ? order.User.name : order.name %>
                    </div>
                    <p>
                        <%= order.address %><br>
                            <% if (order.User) { %>
                                <%= order.User.email %>
                                    <% } %>
                    </p>
                </div>
            </div>

            <hr class="divider">

            <div class="driver-note">
                <strong>Order:</strong>
                <%= order.name %> &nbsp;|&nbsp;
                    <strong>Driver:</strong>
                    <% if (order.Driver) { %>
                        <%= order.Driver.name %> (<%= order.Driver.license %>) · <%= order.Driver.phoneNumber %>
                                    <% } else { %>–<% } %>
            </div>

            <table class="items-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    <% lineItems.forEach(function(item, i) { %>
                        <tr>
                            <td style="color:#C4A882">
                                <%= i + 1 %>
                            </td>
                            <td><strong>
                                    <%= item.name %>
                                </strong></td>
                            <td>
                                <%= item.quantity %>
                            </td>
                            <td>
                                <%= formatRupiah(item.price) %>
                            </td>
                        </tr>
                        <% }) %>
                            <% if (lineItems.length===0) { %>
                                <tr>
                                    <td colspan="4" style="text-align:center;color:#ccc;padding:24px;">No items found.
                                    </td>
                                </tr>
                                <% } %>
                </tbody>
            </table>

            <div class="totals-section">
                <div class="totals-table">
                    <div class="row"><span>Subtotal</span><span>
                            <%= formatRupiah(subtotal) %>
                        </span></div>
                    <div class="row"><span>Tax (0%)</span><span>
                            <%= formatRupiah(0) %>
                        </span></div>
                    <div class="row total">
                        <span>Total</span>
                        <span class="amount">
                            <%= formatRupiah(subtotal) %>
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <div class="invoice-footer">
            <p>🍖 Terima kasih atas pesananmu!</p>
            <button class="print-btn" onclick="window.print()">🖨️ Print Invoice</button>
        </div>

    </div>
</body>

</html>