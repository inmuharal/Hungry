<style>
  .navbar-inner-appetite {
    background: #3E1F0D;
    box-shadow: 0 3px 16px rgba(62, 31, 13, .4);
  }

  .navbar-inner-appetite .navbar-brand {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: 1.4rem;
    color: #D4A017 !important;
  }

  .navbar-inner-appetite .form-control {
    border: 2px solid #D4A017;
    border-radius: 50px;
    background: rgba(255, 255, 255, .08);
    color: #fff;
    padding: 6px 16px;
  }

  .navbar-inner-appetite .form-control::placeholder {
    color: rgba(255, 255, 255, .5);
  }

  .navbar-inner-appetite .form-control:focus {
    background: rgba(255, 255, 255, .15);
    box-shadow: 0 0 0 3px rgba(212, 160, 23, .3);
    border-color: #E67E22;
    color: #fff;
  }

  .btn-search-app {
    background: linear-gradient(135deg, #D4A017, #E67E22);
    color: #fff;
    border: none;
    border-radius: 50px;
    font-weight: 800;
    padding: 6px 20px;
    transition: opacity .2s;
  }

  .btn-search-app:hover {
    opacity: .85;
    color: #fff;
  }

  .navbar-user-badge-app {
    background: rgba(212, 160, 23, .18);
    color: #D4A017;
    border: 1px solid rgba(212, 160, 23, .4);
    font-weight: 700;
    border-radius: 50px;
    padding: 5px 14px;
    font-size: .85rem;
  }

  .btn-nav-app {
    border: 2px solid #D4A017;
    color: #D4A017;
    background: transparent;
    border-radius: 50px;
    font-weight: 700;
    padding: 5px 16px;
    transition: all .2s;
  }

  .btn-nav-app:hover {
    background: #D4A017;
    color: #3E1F0D;
  }

  .btn-logout-app {
    background: linear-gradient(135deg, #C0392B, #E74C3C);
    color: #fff;
    border: none;
    border-radius: 50px;
    font-weight: 700;
    padding: 5px 16px;
    transition: opacity .2s;
  }

  .btn-logout-app:hover {
    opacity: .85;
    color: #fff;
  }
</style>
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Nunito:wght@600;700;800&display=swap"
  rel="stylesheet">

<nav class="navbar navbar-expand-lg navbar-inner-appetite">
  <div class="container">
    <a class="navbar-brand" href="/menus">🍖 HUNGRY UP</a>
    <form class="d-flex mx-auto" action="/menus" method="get" style="max-width:420px;width:100%;">
      <input class="form-control me-2" type="search" name="search" placeholder="🔍 Cari menu..."
        value="<%= typeof search !== 'undefined' ? search : '' %>">
      <button class="btn btn-search-app" type="submit">Search</button>
    </form>
    <div class="d-flex gap-2 align-items-center">
      <span class="navbar-user-badge-app">Hi, <%= userName %> (<%= userRole %>)</span>
      <a href="/orders" class="btn btn-nav-app">📦 Orders</a>
      <a href="/drivers" class="btn btn-nav-app">🚗 Drivers</a>
      <a href="/logout" class="btn btn-logout-app">Logout</a>
    </div>
  </div>
</nav>