<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Drivers – HUNGRY UP</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Nunito:wght@400;600;700;800&display=swap"
    rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    * {
      font-family: 'Nunito', sans-serif;
    }

    body {
      background: #FFF8F0;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-weight: 900;
      color: #3E1F0D;
    }

    .section-title span {
      color: #C0392B;
    }

    .table-wrapper {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 4px 16px rgba(192, 57, 43, .1);
      overflow: hidden;
    }

    .table thead {
      background: linear-gradient(135deg, #3E1F0D, #6B2D0F);
      color: #FFF8F0;
    }

    .table thead th {
      border: none;
      font-weight: 800;
      padding: 14px 12px;
    }

    .table tbody tr:hover {
      background: #FFF8F0;
    }

    .badge-license {
      background: linear-gradient(135deg, #D4A017, #E67E22);
      color: #fff;
      border-radius: 50px;
      padding: 3px 12px;
      font-size: .78rem;
      font-weight: 800;
    }

    .badge-user-sm {
      background: #FFF0E0;
      color: #6B2D0F;
      border: 1px solid #E8C9A0;
      border-radius: 50px;
      padding: 2px 10px;
      font-size: .75rem;
      font-weight: 700;
    }

    .total-badge {
      background: linear-gradient(135deg, #C0392B, #E74C3C);
      color: #fff;
      border-radius: 50px;
      padding: 4px 14px;
      font-weight: 800;
      font-size: .9rem;
    }

    .alert-info {
      border-radius: 14px;
      border: none;
      background: #FFF8F0;
      color: #6B2D0F;
      font-weight: 700;
      border-left: 4px solid #D4A017;
    }
  </style>
</head>

<body>
  <%- include("navbar", { search: "" }) %>
    <div class="container py-4">
      <h3 class="section-title mb-4">🚗 Driver <span>List</span></h3>

      <% if (data.length===0) { %>
        <div class="alert alert-info">Belum ada driver terdaftar.</div>
        <% } else { %>
          <div class="table-wrapper">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Driver Name</th>
                    <th>Phone</th>
                    <th>License</th>
                    <th>Orders</th>
                    <th>Ordered Food</th>
                    <th>Total Orders</th>
                  </tr>
                </thead>
                <tbody>
                  <% data.forEach((driver, index)=> { %>
                    <tr>
                      <td>
                        <%= index + 1 %>
                      </td>
                      <td><strong>
                          <%= driver.name %>
                        </strong></td>
                      <td>
                        <%= driver.phoneNumber %>
                      </td>
                      <td><span class="badge-license">
                          <%= driver.license %>
                        </span></td>
                      <td>
                        <% if (driver.Orders && driver.Orders.length) { %>
                          <ul class="mb-0 ps-3">
                            <% driver.Orders.forEach(order=> { %>
                              <li>
                                <span class="fw-semibold">
                                  <%= order.name %>
                                </span>
                                <span class="text-muted small"> – <%= order.address %></span>
                                <% if (order.User) { %><br><span class="badge-user-sm">
                                    <%= order.User.name %>
                                  </span>
                                  <% } %>
                              </li>
                              <% }) %>
                          </ul>
                          <% } else { %><span class="text-muted">–</span>
                            <% } %>
                      </td>
                      <td>
                        <% if (driver.Orders && driver.Orders.length) { %>
                          <% const allMenus=[]; driver.Orders.forEach(o=> { if (o.Menus && o.Menus.length)
                            o.Menus.forEach(m => allMenus.push(m.menu)); }); %>
                            <% if (allMenus.length) { %>
                              <ul class="mb-0 ps-3">
                                <% allMenus.forEach(n=> { %><li>
                                    <%= n %>
                                  </li>
                                  <% }) %>
                              </ul>
                              <% } else { %><span class="text-muted">–</span>
                                <% } %>
                                  <% } else { %><span class="text-muted">–</span>
                                    <% } %>
                      </td>
                      <td><span class="total-badge">
                          <%= (driver.Orders && driver.Orders.length) ? driver.Orders.length : 0 %>
                        </span></td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
            </div>
          </div>
          <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>